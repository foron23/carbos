# ============================================================================
# Project Makefile — generated by the personal harness
# Self-documenting. Run `make` or `make help` for the target list.
# Override any variable, e.g. `make test PYTEST_ARGS="-k foo"`.
# ============================================================================

SHELL := /bin/bash
.DEFAULT_GOAL := help

# --- Stack detection --------------------------------------------------------
HAS_NODE := $(if $(wildcard package.json),1)
HAS_PY   := $(if $(wildcard pyproject.toml),1,$(if $(wildcard setup.py),1,$(if $(wildcard requirements.txt),1)))
HAS_RUST := $(if $(wildcard Cargo.toml),1)
HAS_GO   := $(if $(wildcard go.mod),1)

# --- Overridable toolchain --------------------------------------------------
NPM      ?= npm
PNPM     ?= pnpm
PYTHON   ?= python3
PIP      ?= $(PYTHON) -m pip
CARGO    ?= cargo
GO       ?= go

# --- Tunables ---------------------------------------------------------------
PORT     ?= 8000

.PHONY: help setup install build test lint format format-check check run dev clean

## help: Show this help
help:
	@printf '\nUsage: make <target>\n\n'
	@grep -hE '^## ' $(MAKEFILE_LIST) | sed 's/^## //' | awk -F': ' '{printf "  \033[36m%-14s\033[0m %s\n", $$1, $$2}'
	@printf '\n'

## setup: Alias for install
setup: install

## install: Install dependencies for the detected stack
install:
ifeq ($(HAS_NODE),1)
	$(NPM) install
endif
ifeq ($(HAS_PY),1)
	@if [ -f pyproject.toml ]; then $(PIP) install -e .; else $(PIP) install -r requirements.txt; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) fetch
endif
ifeq ($(HAS_GO),1)
	$(GO) mod download
endif

## build: Build the project
build:
ifeq ($(HAS_NODE),1)
	$(NPM) run build
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) build
endif
ifeq ($(HAS_GO),1)
	$(GO) build ./...
endif

## test: Run the test suite
test:
ifeq ($(HAS_NODE),1)
	$(NPM) test
endif
ifeq ($(HAS_PY),1)
	$(PYTHON) -m pytest $(PYTEST_ARGS)
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) test
endif
ifeq ($(HAS_GO),1)
	$(GO) test ./...
endif

## lint: Run linters / static analysis
lint:
ifeq ($(HAS_NODE),1)
	$(NPM) run lint
endif
ifeq ($(HAS_PY),1)
	@if command -v ruff >/dev/null 2>&1; then ruff check .; else $(PYTHON) -m pyflakes . 2>/dev/null || echo "no python linter found (install ruff)"; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) clippy --all-targets -- -D warnings
endif
ifeq ($(HAS_GO),1)
	$(GO) vet ./...
endif

## format: Auto-format the codebase
format:
ifeq ($(HAS_NODE),1)
	@if command -v prettier >/dev/null 2>&1; then npx --no-install prettier --write .; else echo "prettier not installed"; fi
endif
ifeq ($(HAS_PY),1)
	@if command -v ruff >/dev/null 2>&1; then ruff format .; else echo "ruff not installed"; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) fmt
endif
ifeq ($(HAS_GO),1)
	$(GO) fmt ./...
endif

## format-check: Verify formatting without modifying files
format-check:
ifeq ($(HAS_NODE),1)
	@if command -v prettier >/dev/null 2>&1; then npx --no-install prettier --check .; else echo "prettier not installed"; fi
endif
ifeq ($(HAS_PY),1)
	@if command -v ruff >/dev/null 2>&1; then ruff format --check .; else echo "ruff not installed"; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) fmt --check
endif
ifeq ($(HAS_GO),1)
	@files="$$(gofmt -l .)"; if [ -n "$$files" ]; then echo "unformatted Go files:"; echo "$$files"; exit 1; fi
endif

## check: Run format check, lint then tests (pre-commit gate)
check: format-check lint test

## run: Run the application
run:
ifeq ($(HAS_NODE),1)
	$(NPM) run start
endif
ifeq ($(HAS_PY),1)
	@if [ -f manage.py ]; then $(PYTHON) manage.py runserver $(PORT); else $(PYTHON) -m main 2>/dev/null || $(PYTHON) main.py; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) run
endif
ifeq ($(HAS_GO),1)
	$(GO) run .
endif

## dev: Start the app in watch/development mode
dev:
ifeq ($(HAS_NODE),1)
	$(NPM) run dev
endif
ifeq ($(HAS_PY),1)
	@if command -v uvicorn >/dev/null 2>&1; then uvicorn app:app --reload --port $(PORT); else echo "no dev server configured"; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) watch -x run 2>/dev/null || $(CARGO) run
endif
ifeq ($(HAS_GO),1)
	@command -v air >/dev/null 2>&1 && air || $(GO) run .
endif

## clean: Remove build artifacts and caches
clean:
	rm -rf dist build .pytest_cache .ruff_cache .mypy_cache target 2>/dev/null || true
	@find . -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
