# ============================================================================
# Project Makefile — generated by the personal harness
# Self-documenting. Run `make` or `make help` for the target list.
# Override any variable, e.g. `make test PYTEST_ARGS="-k foo"`.
# ============================================================================

SHELL := /bin/bash
.DEFAULT_GOAL := help

# --- Stack detection --------------------------------------------------------
HAS_NODE := $(if $(wildcard package.json),1)
HAS_PY   := $(if $(wildcard pyproject.toml),1,$(if $(wildcard setup.py),1,$(if $(wildcard requirements.txt),1)))
HAS_RUST := $(if $(wildcard Cargo.toml),1)
HAS_GO   := $(if $(wildcard go.mod),1)

# --- Overridable toolchain --------------------------------------------------
NPM      ?= npm
PNPM     ?= pnpm
PYTHON   ?= python3
PIP      ?= $(PYTHON) -m pip
CARGO    ?= cargo
GO       ?= go

# --- Tunables ---------------------------------------------------------------
PORT     ?= 8000

# --- Identidad de build (despliegue) ----------------------------------------
# Se sella en el service worker para invalidar el cache en cada publicacion.
BUILD_ID ?= dev

# --- E2E --------------------------------------------------------------------
# Firefox para la prueba E2E. Por defecto, el del sistema si existe; en CI se
# instala el que Puppeteer espera y se llama con `E2E_FIREFOX=` (vacio).
E2E_FIREFOX ?= $(wildcard /usr/bin/firefox)

# --- Entrenamiento (cabeza nueva) -------------------------------------------
# Ver docs/specs/08-linear-probe.md. El codigo de entrenamiento vive en training/.
TRAIN_DATA ?= training/data
TRAIN_OUT  ?= training/out
TRAIN_ARGS ?=
EXPORT_ARGS ?=
# Destilacion Swin -> MobileNetV3 (ver training/distill.py). Requiere tools/shortlist/.venv.
DISTILL_ARGS ?=
# Destilacion CLIP (zero-shot) -> catalogo (ver training/distill_clip.py).
DISTILL_CLIP_ARGS ?=
# Fuente de imagenes + etiquetado asistido (ver tools/data/, D25/spec 12).
DATA_ARGS ?= --classes pan_blanco,tomate --per-class 4
# Revision/confirmacion de etiquetas y empaquetado del dataset.
CONFIRM_ARGS ?= --queue data/labels/review.queue.jsonl
PACKAGE_ARGS ?= --images data/images --format targz --out dist/dataset --free-only

# --- Pesos de produccion ----------------------------------------------------
# Ver docs/specs/03-despliegue.md. Genera weights/ (en este repo) + el manifest.
WEIGHTS_VERSION ?= 0.1.0
WEIGHTS_REPO    ?= foron23/carbos
WEIGHTS_BASE    ?=
WEIGHTS_ARGS    ?=

# --- Banco de evaluacion (Nutrition5k) --------------------------------------
# Ver docs/specs/10-experimento.md. --limit 0 evalua los 709 platos del test.
EVAL_ARGS ?= --manifest public/model-manifest.json --root public --limit 25

.PHONY: help setup install build test e2e lint format format-check check run dev clean \
        build-stamp verify-bundle train-setup train train-smoke export-model distill distill-clip \
        data-images data-review data-confirm data-package catalog \
        weights-manifest smoke-setup smoke-models smoke-clean eval

## help: Show this help
help:
	@printf '\nUsage: make <target>\n\n'
	@grep -hE '^## ' $(MAKEFILE_LIST) | sed 's/^## //' | awk -F': ' '{printf "  \033[36m%-16s\033[0m %s\n", $$1, $$2}'
	@printf '\n'

## setup: Alias for install
setup: install

## install: Install dependencies for the detected stack
install:
ifeq ($(HAS_NODE),1)
	$(NPM) install
endif
ifeq ($(HAS_PY),1)
	@if [ -f pyproject.toml ]; then $(PIP) install -e .; else $(PIP) install -r requirements.txt; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) fetch
endif
ifeq ($(HAS_GO),1)
	$(GO) mod download
endif

## build: Build the project
build:
ifeq ($(HAS_NODE),1)
	$(NPM) run build
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) build
endif
ifeq ($(HAS_GO),1)
	$(GO) build ./...
endif

## test: Run the test suite
test:
ifeq ($(HAS_NODE),1)
	$(NPM) test
endif
ifeq ($(HAS_PY),1)
	$(PYTHON) -m pytest $(PYTEST_ARGS)
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) test
endif
ifeq ($(HAS_GO),1)
	$(GO) test ./...
endif

## e2e: Prueba E2E real en Firefox headless sobre el build (requiere firefox)
e2e: build
	CARBOS_FIREFOX="$(E2E_FIREFOX)" $(NPM) run e2e

## audit-uiux: Audita la UI sobre el build (desborde, nombres accesibles, tactil)
audit-uiux: build
	CARBOS_FIREFOX="$(E2E_FIREFOX)" $(NPM) run audit-uiux

## shots: Guarda capturas de los estados de la UI en e2e/screenshots/uiux/
shots: build
	CARBOS_FIREFOX="$(E2E_FIREFOX)" $(NPM) run shots

## build-stamp: Build + sella el service worker con BUILD_ID (cache-busting de Pages)
build-stamp: build
	node -e "const fs=require('fs');const p='dist/sw.js';if(fs.existsSync(p)){const id=process.env.BUILD_ID||'$(BUILD_ID)';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/__BUILD__/g,id));}"

## verify-bundle: Falla si dist/ lleva pesos de modelo (D18/D24: viven fuera)
verify-bundle:
	@files="$$(find dist -type f \( -name '*.onnx' -o -name '*.pt' -o -name '*.bin' -o -name '*.tflite' -o -name '*.onnx.data' \) 2>/dev/null | sort)"; \
	if [ -n "$$files" ]; then echo "El artefacto contiene pesos de modelo: $$files" >&2; exit 1; fi; \
	echo "Artefacto sin pesos: ok."

## lint: Run linters / static analysis
lint:
ifeq ($(HAS_NODE),1)
	$(NPM) run lint
endif
ifeq ($(HAS_PY),1)
	@if command -v ruff >/dev/null 2>&1; then ruff check .; else $(PYTHON) -m pyflakes . 2>/dev/null || echo "no python linter found (install ruff)"; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) clippy --all-targets -- -D warnings
endif
ifeq ($(HAS_GO),1)
	$(GO) vet ./...
endif

## format: Auto-format the codebase
format:
ifeq ($(HAS_NODE),1)
	$(NPM) run format
endif
ifeq ($(HAS_PY),1)
	@if command -v ruff >/dev/null 2>&1; then ruff format .; else echo "ruff not installed"; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) fmt
endif
ifeq ($(HAS_GO),1)
	$(GO) fmt ./...
endif

## format-check: Verify formatting without modifying files
format-check:
ifeq ($(HAS_NODE),1)
	$(NPM) run format:check
endif
ifeq ($(HAS_PY),1)
	@if command -v ruff >/dev/null 2>&1; then ruff format --check .; else echo "ruff not installed"; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) fmt --check
endif
ifeq ($(HAS_GO),1)
	@files="$$(gofmt -l .)"; if [ -n "$$files" ]; then echo "unformatted Go files:"; echo "$$files"; exit 1; fi
endif

## check: Run format check, lint then tests (pre-commit gate)
check: format-check lint test

## run: Run the application
run:
ifeq ($(HAS_NODE),1)
	$(NPM) run start
endif
ifeq ($(HAS_PY),1)
	@if [ -f manage.py ]; then $(PYTHON) manage.py runserver $(PORT); else $(PYTHON) -m main 2>/dev/null || $(PYTHON) main.py; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) run
endif
ifeq ($(HAS_GO),1)
	$(GO) run .
endif

## dev: Start the app in watch/development mode
dev:
ifeq ($(HAS_NODE),1)
	$(NPM) run dev
endif
ifeq ($(HAS_PY),1)
	@if command -v uvicorn >/dev/null 2>&1; then uvicorn app:app --reload --port $(PORT); else echo "no dev server configured"; fi
endif
ifeq ($(HAS_RUST),1)
	$(CARGO) watch -x run 2>/dev/null || $(CARGO) run
endif
ifeq ($(HAS_GO),1)
	@command -v air >/dev/null 2>&1 && air || $(GO) run .
endif

## train-setup: Instala las dependencias de entrenamiento (Python; ver docs/specs/08-linear-probe.md)
train-setup:
	$(PYTHON) -m pip install -r training/requirements.txt

## train: Entrena la cabeza nueva (linear probe) sobre el set propio
train:
	$(PYTHON) training/linear_probe.py --data $(TRAIN_DATA) --out $(TRAIN_OUT) $(TRAIN_ARGS)

## train-smoke: Prueba el pipeline de entrenamiento sin datos (dry-run)
train-smoke:
	$(PYTHON) training/linear_probe.py --dry-run --out $(TRAIN_OUT) $(TRAIN_ARGS)

## export-model: Exporta a ONNX int8 y escribe el manifest del clasificador
export-model:
	$(PYTHON) training/export_onnx.py --model $(TRAIN_OUT)/model.pt --out $(TRAIN_OUT) $(EXPORT_ARGS)

## distill: Destila Swin Food-101 int8 -> MobileNetV3-Large (requiere tools/shortlist/.venv)
distill:
	tools/shortlist/.venv/bin/python training/distill.py --stage all --out $(TRAIN_OUT) $(DISTILL_ARGS)

## distill-clip: Destila CLIP (zero-shot) al catalogo -> MobileNetV3 (requiere tools/shortlist/.venv)
distill-clip:
	tools/shortlist/.venv/bin/python training/distill_clip.py --stage all --out $(TRAIN_OUT) $(DISTILL_CLIP_ARGS)

## data-images: Descarga imagenes por clase del catalogo desde Wikimedia Commons
data-images:
	python3 tools/data/fetch_images.py $(DATA_ARGS)

## data-review: CLIP propone la clase del catalogo y marca lo que hay que revisar
data-review:
	tools/shortlist/.venv/bin/python tools/data/review_labels.py $(DATA_ARGS)

## data-confirm: Revisa la cola y materializa data/confirmed (etiquetas confirmadas)
data-confirm:
	python3 tools/data/confirm_labels.py $(CONFIRM_ARGS)

## data-package: Empaqueta el dataset (imagenes + etiquetas + atribucion) para compartir
data-package:
	python3 tools/data/package_dataset.py $(PACKAGE_ARGS)

## catalog: Regenera src/catalog/catalog.ts desde Ciqual 2020 (tools/catalog/build_catalog.py)
catalog:
	$(PYTHON) tools/catalog/build_catalog.py

## smoke-setup: Crea tools/smoke/.venv con onnx/numpy/onnxruntime para el smoke test local
smoke-setup:
	$(PYTHON) -m venv tools/smoke/.venv
	tools/smoke/.venv/bin/python -m pip install -r tools/smoke/requirements.txt

## weights-manifest: Genera weights/ y public/model-manifest.json desde los pesos reales (D24)
weights-manifest:
	$(PYTHON) tools/publish/build_manifest.py --version $(WEIGHTS_VERSION) \
		--repo $(WEIGHTS_REPO) $(if $(WEIGHTS_BASE),--base-url $(WEIGHTS_BASE)) $(WEIGHTS_ARGS)

## smoke-models: Genera modelos ONNX de prueba y un manifest local de smoke
smoke-models:
	@if [ -x tools/smoke/.venv/bin/python ]; then \
		tools/smoke/.venv/bin/python tools/smoke/make_models.py; \
	else \
		$(PYTHON) tools/smoke/make_models.py; \
	fi
	@echo "aviso: manifest de smoke (version 'smoke'); 'make smoke-clean' restaura el de produccion"

## smoke-clean: Borra los modelos de prueba y restaura el manifest de produccion
smoke-clean:
	rm -rf public/models
	@if git ls-files --error-unmatch public/model-manifest.json >/dev/null 2>&1; then \
		git checkout -- public/model-manifest.json; \
	else \
		rm -f public/model-manifest.json; \
	fi

## eval: Corre el banco de Nutrition5k sobre el manifest de modelos (ver docs/specs/10-experimento.md)
eval:
	@npx --no-install esbuild eval/run.ts --bundle --platform=node --format=esm --target=node20 \
		--outfile=eval/.build/run.mjs --external:onnxruntime-node --external:pngjs
	@node eval/.build/run.mjs $(EVAL_ARGS)

## clean: Remove build artifacts and caches
clean:
	rm -rf dist build .pytest_cache .ruff_cache .mypy_cache target 2>/dev/null || true
	@find . -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
