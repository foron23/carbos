node_modules/
dist/
coverage/
*.local
.DS_Store

# Artefactos de la prueba E2E (capturas y ficheros temporales)
e2e/screenshots/
e2e/tmp/

# Prototipos desechables de UI (comparativas de diseno; no forman parte del build)
prototypes/

# Entrenamiento (datos y pesos nunca al repo; ver docs/specs/08-linear-probe.md)
training/data/
training/out/
# Imagenes descargadas (Wikimedia Commons) y etiquetas propuestas/revisadas (D25/spec 12)
# Solo el directorio raiz data/ (no tools/data/, que es codigo)
/data/
__pycache__/
*.pyc
*.pt
*.onnx
# Excepcion: pesos publicados en este mismo repo, servidos por jsDelivr (D24);
# viven fuera de public/ para no entrar en el artefacto de Pages.
!weights/
!weights/*.onnx

# Cache de la tabla Ciqual descargada por tools/catalog/build_catalog.py
tools/catalog/.cache/

# Smoke test local: modelos ONNX de prueba y venv (nunca al repo)
public/models/
tools/smoke/.venv/

# Banco de evaluacion (build, cache y resultados)
eval/.build/
eval/cache/
eval/results/

# Shortlist de modelos (venv de conversion)
tools/shortlist/.venv/

# Pack offline de codigos de barras: area de trabajo del builder (ignorada). El pack
# "de arranque" que viaja CON la app vive en public/barcode/ y SI se versiona
# (pequeno, ODbL-1.0 con atribucion en la UI); se regenera con `make barcode-pack`.
tools/barcode/out/

# Ficheros temporales de depuracion
*.tmp.mjs
